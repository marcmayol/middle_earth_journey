# Plantilla de la firma de release. Copia este archivo a keystore.properties
# (que NO se versiona) y rellena los valores reales.
#
# La keystore vive fuera del repo. Si se pierde, las instalaciones existentes
# no se pueden actualizar nunca más: guárdala con copia de seguridad.
#
# Alternativa sin fichero: definir las variables de entorno
# MEJ_STORE_FILE, MEJ_STORE_PASSWORD, MEJ_KEY_ALIAS y MEJ_KEY_PASSWORD;
# scripts/publicar_release.py genera un keystore.properties temporal y lo borra.

storeFile=C:/ruta/a/tu/middleearthjourney.jks
storePassword=
keyAlias=middleearth
keyPassword=
